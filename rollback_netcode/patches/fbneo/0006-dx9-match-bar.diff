+static int dx9Exit()
+{
+	dx9ReleaseResources();
+
+	VidSFreeVidImage();
+
+	vid_FontExit();
+
+	RELEASE(pD3DDevice);
+	RELEASE(pD3D);
+
+	nRotateGame = 0;
+
+	return 0;
+}
