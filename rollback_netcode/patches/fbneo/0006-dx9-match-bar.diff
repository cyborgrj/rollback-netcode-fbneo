-	vertex pVertex[4] = {
-		{ (float)x, (float)y + height, 0.0f, 1.0f, color },
-		{ (float)x, (float)y, 0.0f, 1.0f, color },
-		{ (float)x + width, (float)y + height, 0.0f, 1.0f, color },
-		{ (float)x + width, (float)y, 0.0f, 1.0f, color }
