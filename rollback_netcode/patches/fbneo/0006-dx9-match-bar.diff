+#define RBFCOL(x) ((D3DCOLOR)(0xFF000000u | (x)))
+
 static void textout(ID3DXFont *font, TCHAR *str, RECT dst, DWORD shadow, DWORD flags, DWORD color)
 {
 	if (shadow) {
@@ -1015,8 +1035,157 @@ static void textout(ID3DXFont *font, TCHAR *str, RECT dst, DWORD shadow, DWORD f
