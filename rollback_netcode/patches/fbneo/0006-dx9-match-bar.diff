-	pD3DDevice->SetRenderState(D3DRS_STENCILENABLE, FALSE);
-	pD3DDevice->SetRenderState(D3DRS_ZENABLE, D3DZB_FALSE);
-	pD3DDevice->DrawPrimitiveUP(D3DPT_TRIANGLESTRIP, 2, pVertex, sizeof(vertex));
