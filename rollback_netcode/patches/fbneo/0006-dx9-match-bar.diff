 }
 
+// rollback_netcode ---------------------------------------------------------
+// The match bar, drawn here rather than into the game image. The game image
+// is about 384 pixels wide, so a name drawn there is eight pixels tall before
+// this blitter magnifies it - legible, but soft in a way no amount of care at
+// that size can fix. Drawn at window resolution it is simply sharp.
+// A proper outline, not a shadow. textout() above offsets by one pixel in four
+// directions, which disappears at this size; an arcade name bar wants the
+// letter ringed in black on every side so it survives a bright stage behind it.
+// Thickness follows the font size, and the ring is filled rather than traced so
+// there are no gaps on the diagonals.
+static void RbfTextOut(ID3DXFont* font, TCHAR* str, RECT rc, DWORD colour, int thick)
+{
+	if (!font || !str || !str[0]) return;
+	const DWORD flags = DT_LEFT | DT_TOP | DT_NOCLIP | DT_SINGLELINE;
+
+	if (thick < 1) thick = 1;
+	if (thick > 2) thick = 2;
+
+	for (int dy = -thick; dy <= thick; dy++) {
+		for (int dx = -thick; dx <= thick; dx++) {
+			if (dx == 0 && dy == 0) continue;
+			RECT o = rc;
+			o.left += dx; o.right += dx;
+			o.top  += dy; o.bottom += dy;
+			font->DrawText(NULL, str, -1, &o, flags, 0xFF000000);
+		}
+	}
+	// Twice. The glyph is anti-aliased, so its edge pixels are part
+	// transparent and blend with the black ring underneath - which reads as a
+	// dark smudge eating into the letter. Laying it down a second time
+	// saturates those edges and the letter comes back.
+	font->DrawText(NULL, str, -1, &rc, flags, colour);
+	font->DrawText(NULL, str, -1, &rc, flags, colour);
+}
+
+static int RbfMeasure(ID3DXFont* font, TCHAR* str)
+{
+	if (!font || !str || !str[0]) return 0;
+	RECT rc = { 0, 0, 0, 0 };
+	font->DrawText(NULL, str, -1, &rc, DT_CALCRECT | DT_SINGLELINE, 0xFFFFFFFF);
+	return rc.right - rc.left;
+}
+
+static void RbfOverlayDraw(RECT frec)
+{
+	// The same normalisation vid_FontDraw does: in a window the rect is
+	// relative to the game image, not to the desktop.
+	if (!nVidFullscreen) {
+		frec.top = 0;
+		frec.left = 0;
+		frec.right = Dest.right - Dest.left;
+		frec.bottom = Dest.bottom - Dest.top;
+	}
+
+	OverlayLine L;
+	if (!OverlayGetLine(&L)) return;
+
+	const int W = frec.right - frec.left;
+	const int H = frec.bottom - frec.top;
+	if (W <= 0 || H <= 0) return;
+
+	// Sized from the window, so it stays the same apparent size in a small
+	// window and in fullscreen.
+	int want = (L.nMode == 2) ? (H / 16) : (H / 26);
+	if (want < 11) want = 11;
+	if (want > 64) want = 64;
+
+	const int slot = (L.nMode == 2) ? 1 : 0;
+	if (nRbfFontPx[slot] != want) {
+		RELEASE(pRbfFont[slot]);
+		pRbfFont[slot] = NULL;
+		TCHAR szFace[64];
+		_sntprintf(szFace, 63, _T("%S"), OverlayFaceName());
+		HRESULT hr = _D3DXCreateFont(pD3DDevice, want, 0, FW_BOLD, 1, FALSE,
+							  DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, ANTIALIASED_QUALITY,
+							  DEFAULT_PITCH | FF_DONTCARE, szFace, &pRbfFont[slot]);
+
+		// Checking the pointer, not just the HRESULT. When d3dx9_43.dll is
+		// missing, directx9_core.cpp swaps every entry point for a stub that
+		// returns S_OK and does nothing - so a plain FAILED() test passes and
+		// leaves us with a null font. Hand the bar back to the in-image path
+		// rather than silently drawing nothing.
+		if (FAILED(hr) || !pRbfFont[slot]) {
+			pRbfFont[slot] = NULL;
+			OverlayClaim(0);
+			return;
+		}
+		nRbfFontPx[slot] = want;
+	}
+
+	ID3DXFont* font = pRbfFont[slot];
+	if (!font) return;
+
+	TCHAR szP1[64], szS1[16], szFt[24], szS2[16], szP2[64];
+	_sntprintf(szP1, 63, _T("%S"), L.szP1);
+	_sntprintf(szS1, 15, _T("%S"), L.szS1);
+	_sntprintf(szFt, 23, _T("%S"), L.szFt);
+	_sntprintf(szS2, 15, _T("%S"), L.szS2);
+	_sntprintf(szP2, 63, _T("%S"), L.szP2);
+
+	const int w1  = RbfMeasure(font, szP1);
+	const int ws1 = RbfMeasure(font, szS1);
+	const int wft = RbfMeasure(font, szFt);
+	const int ws2 = RbfMeasure(font, szS2);
+	const int gap = want / 2;
+	const int gapL = want;
+
+	const int barH = want + want / 3;
+	Boxxy(frec.left, frec.top, W, barH,
+		  D3DCOLOR_ARGB(L.nBarAlpha, (L.rgbBar >> 16) & 0xFF,
+						  (L.rgbBar >> 8) & 0xFF, L.rgbBar & 0xFF));
+
+	// The middle of the screen is the anchor, not the edges: a very long
+	// name then pushes itself outwards instead of shoving the two scores
+	// off to one side, where they stop reading as a score.
+	const int mid  = frec.left + W / 2;
+	const int half = wft ? (wft / 2 + gapL) : (gapL / 2);
+	const int top  = frec.top + (barH - want) / 2;
+	const int bot  = top + want + want / 2;
+
+	// One pixel of outline disappears on a big screen; two is what reads.
+	const int thick = (want >= 26) ? 2 : 1;
+
+	RECT rc;
+	rc.top = top; rc.bottom = bot;
+
+	rc.right = mid - half;      rc.left = rc.right - ws1;
+	RbfTextOut(font, szS1, rc, RBFCOL(L.rgbScore), thick);
+
+	rc.right = mid - half - ws1 - gap;  rc.left = rc.right - w1;
+	RbfTextOut(font, szP1, rc, RBFCOL(L.rgbP1), thick);
+
+	if (wft) {
+		rc.left = mid - wft / 2; rc.right = rc.left + wft;
+		RbfTextOut(font, szFt, rc, RBFCOL(L.rgbLabel), thick);
+	}
+
+	rc.left = mid + half;       rc.right = rc.left + ws2;
+	RbfTextOut(font, szS2, rc, RBFCOL(L.rgbScore), thick);
+
+	rc.left = mid + half + ws2 + gap;   rc.right = frec.right;
+	RbfTextOut(font, szP2, rc, RBFCOL(L.rgbP2), thick);
+}
+
 static void vid_FontDraw(RECT frec)
 {
+	// rollback_netcode: the match bar is not part of the status display, so
+	// it is drawn before that setting gets a say - somebody who turned the
+	// OSD off still wants to know who they are playing.
+	RbfOverlayDraw(frec);
+
 	if (nVidSDisplayStatus == 0) {
 		return;
 	}
