-static UINT32 __cdecl HighCol15(INT32 r, INT32 g, INT32 b, INT32  /* i */)
-{
-	UINT32 t;
-
-	t  = (r << 7) & 0x7C00;
-	t |= (g << 2) & 0x03E0;
-	t |= (b >> 3) & 0x001F;
-
-	return t;
-}
