+// rollback_netcode ---------------------------------------------------------
+// The netcode readout, top right, at window resolution for the same reason as
+// the bar: eight source pixels of digit cannot be made sharp by stretching.
+// Smaller than the bar - this is telemetry, not the scoreboard - and right
+// aligned so the numbers keep their column as they change width.
+static void RbfHudDraw(RECT frec)
+{
+	if (!nVidFullscreen) {
+		frec.top = 0;
+		frec.left = 0;
+		frec.right = Dest.right - Dest.left;
+		frec.bottom = Dest.bottom - Dest.top;
+	}
+
+	HudLines L;
+	if (!HudGetLines(&L)) return;
+
+	const int W = frec.right - frec.left;
+	const int H = frec.bottom - frec.top;
+	if (W <= 0 || H <= 0) return;
+
+	int want = H / 40;
+	if (want < 9)  want = 9;
+	if (want > 26) want = 26;
+
+	if (nRbfFontPx[2] != want) {
+		RELEASE(pRbfFont[2]);
+		pRbfFont[2] = NULL;
+		TCHAR szFace[64];
+		_sntprintf(szFace, 63, _T("%S"), OverlayMetricFaceName());
+		HRESULT hr = _D3DXCreateFont(pD3DDevice, want, 0, FW_BOLD, 1, FALSE,
+							  DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, ANTIALIASED_QUALITY,
+							  DEFAULT_PITCH | FF_DONTCARE, szFace, &pRbfFont[2]);
+
+		// Same trap as the bar: with d3dx9_43.dll missing the entry points are
+		// stubs that return S_OK and do nothing, so the pointer is what has to
+		// be checked. Hand the job back rather than draw nothing.
+		if (FAILED(hr) || !pRbfFont[2]) {
+			pRbfFont[2] = NULL;
+			OverlayClaim(0);
+			return;
+		}
+		nRbfFontPx[2] = want;
+	}
+
+	ID3DXFont* font = pRbfFont[2];
+	if (!font) return;
+
+	TCHAR sz1[128], sz2[128];
+	_sntprintf(sz1, 127, _T("%S"), L.szLine1);
+	_sntprintf(sz2, 127, _T("%S"), L.szLine2);
+
+	const int w1 = RbfMeasure(font, sz1);
+	const int w2 = (L.nMode >= 2) ? RbfMeasure(font, sz2) : 0;
+	if (w1 <= 0) return;
+
+	const int lineH = want + want / 3;
+	const int lines = (L.nMode >= 2) ? 2 : 1;
+	const int pad   = want / 3 + 2;
+	const int panelW = (w1 > w2 ? w1 : w2) + pad * 2;
+	const int panelH = lineH * lines + pad;
+
+	// Below the match bar when that is up, so the two never overlap.
+	int top = frec.top + 2;
+	OverlayLine B;
+	if (OverlayGetLine(&B)) {
+		int barWant = (B.nMode == 2) ? (H / 16) : (H / 26);
+		if (barWant < 11) barWant = 11;
+		if (barWant > 64) barWant = 64;
+		top = frec.top + barWant + barWant / 3 + 2;
+	}
+
+	const int x0 = frec.right - panelW - 2;
+	Boxxy(x0, top, panelW, panelH,
+		  D3DCOLOR_ARGB(L.nBarAlpha, (L.rgbBar >> 16) & 0xFF,
+						  (L.rgbBar >> 8) & 0xFF, L.rgbBar & 0xFF));
+
+	const int thick = (want >= 26) ? 2 : 1;
+
+	RECT rc;
+	rc.right = frec.right - 2 - pad;
+	rc.left  = rc.right - w1;
+	rc.top   = top + pad / 2;
+	rc.bottom = rc.top + lineH;
+	RbfTextOut(font, sz1, rc, RBFCOL(L.rgbText), thick);
+
+	if (L.nMode >= 2) {
+		rc.right = frec.right - 2 - pad;
+		rc.left  = rc.right - w2;
+		rc.top  += lineH;
+		rc.bottom = rc.top + lineH;
+		RbfTextOut(font, sz2, rc, RBFCOL(L.rgbText), thick);
+	}
+}
