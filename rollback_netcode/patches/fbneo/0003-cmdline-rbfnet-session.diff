+// rollback_netcode: parse  -rbfprobe  (optionally  -rbfprobe interval=30)
+// Arms the work-RAM recorder for this run. Returns the sample interval in
+// frames, or 0 when the flag is absent.
+//
+// This is a calibration tool: it writes a few megabytes per match, and the
+// file is what turns into the per-game scoreboard table. Nothing about a
+// normal match, online or off, touches it.
+static int RbfParseProbe()
+{
+	TCHAR* p = _tcsstr(szCmdLine, _T("-rbfprobe"));
+	if (p == NULL) return 0;
+	p += _tcslen(_T("-rbfprobe"));
+
+	// The interval is the one thing worth tuning by hand, and only when a
+	// match is long enough that half-second samples make an awkward file.
+	TCHAR* eq = _tcsstr(p, _T("interval="));
+	if (eq != NULL && (eq - p) < 8) {
+		int n = _ttoi(eq + _tcslen(_T("interval=")));
+		if (n > 0 && n <= 600) return n;
+	}
+	return 30;		// two samples a second
+}
+
+// rollback_netcode: parse  -rbfnet player=1,localport=7000,peerip=1.2.3.4,peerport=7000,delay=2
+// from the command line into an FbnHostConfig. Returns true when a usable config
+// was found (peer ip + both ports present). Independent of FBNeo's own option
+// parser, same as the -sub / -ips handling does.
+static bool RbfParseNetCfg(FbnHostConfig* cfg)
+{
+	TCHAR* p = _tcsstr(szCmdLine, _T("-rbfnet "));
+	if (p == NULL) return false;
+	p += _tcslen(_T("-rbfnet "));
+
+	TCHAR list[512];
+	_tcsncpy(list, p, 511);
+	list[511] = _T('\0');
+	TCHAR* sp = _tcschr(list, _T(' '));		// the comma-list ends at the next space
+	if (sp) *sp = _T('\0');
+
+	memset(cfg, 0, sizeof(*cfg));
+	cfg->nPlayers     = 2;
+	cfg->nLocalPlayer = 1;
+	cfg->nInputPlayer = 1;   // FBNeo binds the local controls to P1 by default
+	cfg->nFrameDelay  = 2;
+	cfg->nStateSlots  = 0;
+	strncpy(cfg->szGameId, BurnDrvGetTextA(DRV_NAME), sizeof(cfg->szGameId) - 1);
+
+	for (TCHAR* tok = _tcstok(list, _T(",")); tok != NULL; tok = _tcstok(NULL, _T(","))) {
+		TCHAR* eq = _tcschr(tok, _T('='));
+		if (eq == NULL) continue;
+		*eq = _T('\0');
+		TCHAR* key = tok;
+		TCHAR* val = eq + 1;
+
+		if      (_tcscmp(key, _T("player"))      == 0) cfg->nLocalPlayer = _ttoi(val);
+		else if (_tcscmp(key, _T("inputplayer")) == 0) cfg->nInputPlayer = _ttoi(val);
+		else if (_tcscmp(key, _T("players"))   == 0) cfg->nPlayers     = _ttoi(val);
+		else if (_tcscmp(key, _T("localport")) == 0) cfg->nLocalPort   = (unsigned short)_ttoi(val);
+		else if (_tcscmp(key, _T("peerport"))  == 0) cfg->nRemotePort  = (unsigned short)_ttoi(val);
+		else if (_tcscmp(key, _T("delay"))     == 0) cfg->nFrameDelay  = _ttoi(val);
+		else if (_tcscmp(key, _T("ft"))        == 0) cfg->nFirstTo     = _ttoi(val);
+		else if (_tcscmp(key, _T("punchport")) == 0) cfg->nPunchPort   = (unsigned short)_ttoi(val);
+		else if (_tcscmp(key, _T("gamerelay")) == 0) cfg->nGameRelayPort = (unsigned short)_ttoi(val);
+		else if (_tcscmp(key, _T("peerip"))    == 0) {
+			char* a = TCHARToANSI(val, NULL, 0);
+			strncpy(cfg->szRemoteIp, a, sizeof(cfg->szRemoteIp) - 1);
+		}
+		else if (_tcscmp(key, _T("punchip"))   == 0) {
+			char* a = TCHARToANSI(val, NULL, 0);
+			strncpy(cfg->szPunchIp, a, sizeof(cfg->szPunchIp) - 1);
+		}
+		else if (_tcscmp(key, _T("matchid"))   == 0) {
+			char* a = TCHARToANSI(val, NULL, 0);
+			strncpy(cfg->szMatchId, a, sizeof(cfg->szMatchId) - 1);
+		}
+		else if (_tcscmp(key, _T("relayport")) == 0) cfg->nRelayPort   = (unsigned short)_ttoi(val);
+		else if (_tcscmp(key, _T("relayip"))   == 0) {
+			char* a = TCHARToANSI(val, NULL, 0);
+			strncpy(cfg->szRelayIp, a, sizeof(cfg->szRelayIp) - 1);
+		}
+		else if (_tcscmp(key, _T("p1"))        == 0) {
+			char* a = TCHARToANSI(val, NULL, 0);
+			strncpy(cfg->szP1Name, a, sizeof(cfg->szP1Name) - 1);
+		}
+		else if (_tcscmp(key, _T("p2"))        == 0) {
+			char* a = TCHARToANSI(val, NULL, 0);
+			strncpy(cfg->szP2Name, a, sizeof(cfg->szP2Name) - 1);
+		}
+	}
+
+	return (cfg->nLocalPort != 0 && cfg->nRemotePort != 0 && cfg->szRemoteIp[0] != '\0');
+}
+
+// rollback_netcode: parse  -rbfwatch matchid=<id>,relayip=1.2.3.4,relayport=50053
+// A spectator opens no session of its own: it replays the host's confirmed input
+// stream on top of the save state the relay hands out, so it never diverges and
+// can join a fight that is already under way.
+static bool RbfParseWatchCfg(FbnWatchConfig* cfg)
+{
+	TCHAR* p = _tcsstr(szCmdLine, _T("-rbfwatch "));
+	if (p == NULL) return false;
+	p += _tcslen(_T("-rbfwatch "));
+
+	TCHAR list[512];
+	_tcsncpy(list, p, 511);
+	list[511] = _T('\0');
+	TCHAR* sp = _tcschr(list, _T(' '));		// the comma-list ends at the next space
+	if (sp) *sp = _T('\0');
+
+	memset(cfg, 0, sizeof(*cfg));
+
+	for (TCHAR* tok = _tcstok(list, _T(",")); tok != NULL; tok = _tcstok(NULL, _T(","))) {
+		TCHAR* eq = _tcschr(tok, _T('='));
+		if (eq == NULL) continue;
+		*eq = _T('\0');
+		TCHAR* key = tok;
+		TCHAR* val = eq + 1;
+
+		if      (_tcscmp(key, _T("relayport")) == 0) cfg->nRelayPort = (unsigned short)_ttoi(val);
+		else if (_tcscmp(key, _T("relayip"))   == 0) {
+			char* a = TCHARToANSI(val, NULL, 0);
+			strncpy(cfg->szRelayIp, a, sizeof(cfg->szRelayIp) - 1);
+		}
+		else if (_tcscmp(key, _T("matchid"))   == 0) {
+			char* a = TCHARToANSI(val, NULL, 0);
+			strncpy(cfg->szMatchId, a, sizeof(cfg->szMatchId) - 1);
+		}
+	}
+
+	return (cfg->szRelayIp[0] != '\0' && cfg->nRelayPort != 0 && cfg->szMatchId[0] != '\0');
+}
