<Window x:Class="RbfLauncher.Views.ChallengeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desafio"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        MinWidth="380" MaxWidth="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Topmost="True" ShowInTaskbar="True">
  <StackPanel Margin="26" MinWidth="330">
    <TextBlock x:Name="MsgText" FontSize="15" TextWrapping="Wrap" />
    <TextBlock x:Name="CountText" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,10,0,0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Content="Recusar" Style="{StaticResource Btn}" MinWidth="110" MinHeight="34" Click="Decline_Click" />
      <Button Content="Aceitar" Style="{StaticResource BtnPrimary}" MinWidth="110" MinHeight="34" Margin="12,0,0,0" Click="Accept_Click" />
    </StackPanel>
  </StackPanel>
</Window>
