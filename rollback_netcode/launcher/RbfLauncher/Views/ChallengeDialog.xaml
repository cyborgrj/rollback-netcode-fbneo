<Window x:Class="RbfLauncher.Views.ChallengeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desafio" Height="180" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Bg}" Topmost="True">
  <StackPanel Margin="24">
    <TextBlock x:Name="MsgText" FontSize="15" TextWrapping="Wrap" />
    <TextBlock x:Name="CountText" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,8,0,0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Recusar" Style="{StaticResource Btn}" MinWidth="100" Click="Decline_Click" />
      <Button Content="Aceitar" Style="{StaticResource BtnPrimary}" MinWidth="100" Margin="10,0,0,0" Click="Accept_Click" />
    </StackPanel>
  </StackPanel>
</Window>
