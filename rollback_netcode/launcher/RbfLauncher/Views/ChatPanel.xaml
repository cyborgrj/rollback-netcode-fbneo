<UserControl x:Class="RbfLauncher.Views.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1,0,0,0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- tabs -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,0">
        <Button x:Name="GlobalTab" Style="{StaticResource Btn}" Padding="14,6" Margin="0,0,6,0"
                Click="GlobalTab_Click" Content="Geral" />
        <Button x:Name="RoomTab" Style="{StaticResource Btn}" Padding="14,6"
                Click="RoomTab_Click" Content="Sala" />
      </StackPanel>

      <!-- log -->
      <ScrollViewer x:Name="LogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    Margin="10,10,4,0" Padding="0,0,6,0">
        <StackPanel x:Name="LogHost" />
      </ScrollViewer>

      <!-- input -->
      <Grid Grid.Row="2" Margin="10,10,10,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="InputBox" Grid.Column="0" MaxLength="300" FontSize="13" Padding="8,6"
                 Background="{StaticResource BgPanelHi}" Foreground="{StaticResource Text}"
                 BorderBrush="{StaticResource Stroke}" BorderThickness="1" CaretBrush="{StaticResource Text}"
                 KeyDown="InputBox_KeyDown" />
        <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource Btn}" Padding="12,6"
                Margin="6,0,0,0" Click="SendButton_Click" Content="Enviar" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
