<UserControl x:Class="RbfLauncher.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="Escolha um jogo" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
      <TextBlock Text="Entre na sala para testar o jogo ou baixar a ROM."
                 Foreground="{StaticResource TextDim}" Margin="0,0,0,20" />
      <UniformGrid x:Name="Grid" Columns="2" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
