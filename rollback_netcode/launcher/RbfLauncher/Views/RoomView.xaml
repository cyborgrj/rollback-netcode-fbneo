<UserControl x:Class="RbfLauncher.Views.RoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Button x:Name="BackButton" Grid.Row="0" HorizontalAlignment="Left" Style="{StaticResource Btn}"
            Padding="12,6" Margin="0,0,0,16" Click="BackButton_Click" Content="&#8249;  Voltar" />

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- portrait art, shown WHOLE (no crop) -->
      <Border Grid.Column="0" CornerRadius="10" ClipToBounds="True" VerticalAlignment="Top"
              MinHeight="255" MaxHeight="540"
              Background="{StaticResource BgPanelHi}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
        <Grid>
          <Image x:Name="ArtImage" Stretch="Uniform" />
          <TextBlock x:Name="ArtPlaceholder" Visibility="Collapsed" FontSize="26"
                     Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Margin="0,80" />
        </Grid>
      </Border>

      <!-- info + actions -->
      <StackPanel Grid.Column="1" Margin="24,0,0,0">
        <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
        <TextBlock x:Name="SubText" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,4,0,18" />

        <TextBlock x:Name="RomStatusText" FontSize="14" Margin="0,0,0,14" />

        <StackPanel Orientation="Horizontal">
          <Button x:Name="PlayButton" Style="{StaticResource BtnPrimary}" MinWidth="150"
                  Click="PlayButton_Click" Content="Testar jogo" />
          <Button x:Name="DownloadButton" Style="{StaticResource Btn}" MinWidth="150" Margin="12,0,0,0"
                  Click="DownloadButton_Click" Content="Baixar ROM" />
        </StackPanel>

        <TextBlock x:Name="HintText" Foreground="{StaticResource TextDim}" FontSize="12"
                   Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,16,0,0">
          <ProgressBar x:Name="DownloadBar" Height="8" Minimum="0" Maximum="1" IsIndeterminate="False" />
          <TextBlock x:Name="ProgressText" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,6,0,0" />
        </StackPanel>

        <TextBlock x:Name="EmuStatusText" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap" />

        <Border Height="1" Background="{StaticResource Stroke}" Margin="0,24" />

        <TextBlock Text="Sala online" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="OnlineHint" Foreground="{StaticResource TextDim}" FontSize="12"
                   Margin="0,4,0,10" TextWrapping="Wrap" />
        <ItemsControl x:Name="PlayersList" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
