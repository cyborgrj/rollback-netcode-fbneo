<Window x:Class="RbfLauncher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações" Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource Bg}">
  <StackPanel Margin="24">

    <TextBlock Text="API da conta (Django)  —  login, perfil e ranking"
               Foreground="{StaticResource TextDim}" />
    <TextBox x:Name="ApiBox" Margin="0,4,0,16" Padding="6,5" />

    <TextBlock Text="Lobby (IP ou host)  —  usado no &quot;Conectar&quot;" Foreground="{StaticResource TextDim}" />
    <Grid Margin="0,4,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="90" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="HostBox" Grid.Column="0" Margin="0,0,8,0" Padding="6,5" />
      <TextBox x:Name="PortBox" Grid.Column="1" Padding="6,5" ToolTip="Porta (padrão 50051)" />
    </Grid>

    <TextBlock Text="Caminho do fbneo.exe" Foreground="{StaticResource TextDim}" />
    <Grid Margin="0,4,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="EmuBox" Grid.Column="0" Margin="0,0,8,0" Padding="6,5" />
      <Button Grid.Column="1" Content="Procurar…" Style="{StaticResource Btn}" Padding="12,4" Click="BrowseEmu_Click" />
    </Grid>

    <TextBlock Text="Argumentos do emulador  (-w = janela; -noscan pula o audit de ROMs)"
               Foreground="{StaticResource TextDim}" />
    <TextBox x:Name="ArgsBox" Margin="0,4,0,16" Padding="6,5" />

    <TextBlock Text="Pasta das ROMs  —  vazio = &lt;pasta do fbneo.exe&gt;\roms\arcade (onde o FBNeo lê)"
               Foreground="{StaticResource TextDim}" />
    <TextBox x:Name="RomsBox" Margin="0,4,0,20" Padding="6,5" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancelar" Style="{StaticResource Btn}" MinWidth="90" Click="Cancel_Click" />
      <Button Content="Salvar" Style="{StaticResource BtnPrimary}" MinWidth="90" Margin="10,0,0,0" Click="Save_Click" />
    </StackPanel>
  </StackPanel>
</Window>
