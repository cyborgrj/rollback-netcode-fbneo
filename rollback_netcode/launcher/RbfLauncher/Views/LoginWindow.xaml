<Window x:Class="RbfLauncher.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frame Perfect" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource Bg}">
  <StackPanel Margin="28,26,28,24">

    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
      <TextBlock Text="FRAME" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}" />
      <TextBlock Text="PERFECT" FontSize="22" FontWeight="Bold" Margin="7,0,0,0"
                 Foreground="{StaticResource ChatName3}" />
    </StackPanel>
    <TextBlock Text="Entre com sua conta para jogar." Foreground="{StaticResource TextDim}"
               FontSize="12" Margin="0,0,0,20" />

    <TextBlock Text="Usuário" Foreground="{StaticResource TextDim}" />
    <TextBox x:Name="UserBox" Margin="0,4,0,14" Padding="7,6"
             KeyDown="Field_KeyDown" />

    <TextBlock Text="Senha" Foreground="{StaticResource TextDim}" />
    <PasswordBox x:Name="PassBox" Margin="0,4,0,4" Padding="7,6"
                 KeyDown="Field_KeyDown" />

    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" FontSize="12"
               TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />

    <Button x:Name="LoginButton" Content="Entrar" Style="{StaticResource BtnPrimary}"
            Padding="0,9" Margin="0,18,0,0" Click="Login_Click" />

    <!-- The addresses. Folded away because almost nobody touches them, but
         reachable because they change from localhost to the real domain. -->
    <Expander x:Name="ServerExpander" Header="Servidores" Margin="0,16,0,0"
              Foreground="{StaticResource TextDim}" FontSize="12">
      <StackPanel Margin="0,10,0,0">
        <TextBlock Text="API da conta (Django)" Foreground="{StaticResource TextDim}" />
        <TextBox x:Name="ApiBox" Margin="0,4,0,12" Padding="6,5" />

        <TextBlock Text="Lobby (IP ou host)  ·  porta" Foreground="{StaticResource TextDim}" />
        <Grid Margin="0,4,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="86" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="HostBox" Grid.Column="0" Margin="0,0,8,0" Padding="6,5" />
          <TextBox x:Name="PortBox" Grid.Column="1" Padding="6,5" />
        </Grid>
      </StackPanel>
    </Expander>

  </StackPanel>
</Window>
