<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- palette -->
  <SolidColorBrush x:Key="Bg"          Color="#12141A" />
  <SolidColorBrush x:Key="BgPanel"     Color="#1B1F27" />
  <SolidColorBrush x:Key="BgPanelHi"   Color="#232833" />
  <SolidColorBrush x:Key="Stroke"      Color="#2E3440" />
  <SolidColorBrush x:Key="Text"        Color="#E7EAF0" />
  <SolidColorBrush x:Key="TextDim"     Color="#8A93A6" />
  <SolidColorBrush x:Key="Accent"      Color="#4C8DFF" />
  <SolidColorBrush x:Key="AccentText"  Color="#FFFFFF" />
  <SolidColorBrush x:Key="Ok"          Color="#3FB950" />
  <SolidColorBrush x:Key="Warn"        Color="#D29922" />
  <SolidColorBrush x:Key="Bad"         Color="#F0554E" />

  <!-- Chat name colours. Green is reserved for you (the "Ok" brush above), so
       these sweep the rest of the wheel and deliberately avoid greens. ChatPanel
       picks one from a hash of the username, so the same person is the same
       colour on everyone's screen. Add or remove entries freely: the code counts
       how many exist rather than hard-coding twenty. -->
  <SolidColorBrush x:Key="ChatName1"  Color="#5B9CFF" />  <!-- azul     -->
  <SolidColorBrush x:Key="ChatName2"  Color="#4DD0E1" />  <!-- ciano    -->
  <SolidColorBrush x:Key="ChatName3"  Color="#B0A7FF" />  <!-- lilás    -->
  <SolidColorBrush x:Key="ChatName4"  Color="#C792EA" />  <!-- roxo     -->
  <SolidColorBrush x:Key="ChatName5"  Color="#E066D9" />  <!-- magenta  -->
  <SolidColorBrush x:Key="ChatName6"  Color="#FF6E9C" />  <!-- rosa     -->
  <SolidColorBrush x:Key="ChatName7"  Color="#F0716B" />  <!-- vermelho -->
  <SolidColorBrush x:Key="ChatName8"  Color="#FF9E4A" />  <!-- laranja  -->
  <SolidColorBrush x:Key="ChatName9"  Color="#E8D44D" />  <!-- amarelo  -->
  <SolidColorBrush x:Key="ChatName10" Color="#D4A373" />  <!-- caramelo    -->
  <SolidColorBrush x:Key="ChatName11" Color="#7DA0FF" />  <!-- azul claro  -->
  <SolidColorBrush x:Key="ChatName12" Color="#8FD6FF" />  <!-- azul gelo   -->
  <SolidColorBrush x:Key="ChatName13" Color="#5FE3C0" />  <!-- turquesa    -->
  <SolidColorBrush x:Key="ChatName14" Color="#9C8CFF" />  <!-- violeta     -->
  <SolidColorBrush x:Key="ChatName15" Color="#D9A9FF" />  <!-- lavanda     -->
  <SolidColorBrush x:Key="ChatName16" Color="#FF9ECF" />  <!-- rosa claro  -->
  <SolidColorBrush x:Key="ChatName17" Color="#FF8A80" />  <!-- coral       -->
  <SolidColorBrush x:Key="ChatName18" Color="#FFB870" />  <!-- pêssego     -->
  <SolidColorBrush x:Key="ChatName19" Color="#F5C542" />  <!-- âmbar       -->
  <SolidColorBrush x:Key="ChatName20" Color="#C9B896" />  <!-- areia       -->

  <!-- base text -->
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Arial" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <!-- flat button -->
  <Style x:Key="Btn" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Background" Value="{StaticResource BgPanelHi}" />
    <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#2B313D" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="#333B49" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="b" Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- primary (accent) button -->
  <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource AccentText}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#3D7BEC" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="#356AD0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="b" Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- game card button -->
  <ControlTemplate x:Key="CardButtonTemplate" TargetType="Button">
    <Border x:Name="b" CornerRadius="8"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True">
      <ContentPresenter />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter TargetName="b" Property="Background" Value="{StaticResource BgPanelHi}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="b" Property="Background" Value="#262C38" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

</ResourceDictionary>
