<Window x:Class="RbfLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:RbfLauncher.Views"
        Title="Rollback FinalBurn Neo by CyborgRJ" Height="720" Width="1040"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">

  <DockPanel>
    <!-- header -->
    <Border DockPanel.Dock="Top" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Stroke}"
            BorderThickness="0,0,0,1" Padding="20,12">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="ROLLBACK" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Accent}" />
          <TextBlock Text="FinalBurn Neo" FontSize="16" Margin="8,0,0,0" Foreground="{StaticResource TextDim}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock x:Name="PlayerLabel" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,14,0"
                     Cursor="Hand" MouseLeftButtonUp="PlayerLabel_Click" />
          <!-- MinWidth so the neighbouring buttons do not shift when the label swaps -->
          <Button x:Name="ChatToggle" Style="{StaticResource Btn}" Padding="10,6" Margin="0,0,8,0"
                  MinWidth="108" Click="ChatToggle_Click" Content="Mostrar Chat" />
          <Button x:Name="ConnectButton" Style="{StaticResource Btn}" Padding="10,6" Margin="0,0,8,0"
                  Click="ConnectButton_Click" Content="Conectar" />
          <Button x:Name="SettingsButton" Style="{StaticResource Btn}" Padding="10,6" Margin="0,0,8,0"
                  Click="SettingsButton_Click" Content="Configura&#231;&#245;es" />
          <Button x:Name="LogoutButton" Style="{StaticResource Btn}" Padding="10,6"
                  Click="LogoutButton_Click" Content="Sair da conta" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- chat sidebar, hidden until connected -->
    <v:ChatPanel x:Name="Chat" DockPanel.Dock="Right" Width="300" Visibility="Collapsed" />

    <!-- page host -->
    <ContentControl x:Name="Host" />
  </DockPanel>
</Window>
