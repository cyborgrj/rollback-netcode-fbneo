# Servidor de matchmaking do Frame Perfect (RbfServer) como servico do Linux.
# Nao tem relacao com o site: so diz ao systemd como ligar o lobby.
#   sudo cp rbfserver.service /etc/systemd/system/

[Unit]
Description=Frame Perfect - lobby e matchmaking (.NET)
After=network.target frameperfect-web.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/rbfserver
ExecStart=/home/ubuntu/rbfserver/RbfServer --bind 0.0.0.0 --port 50051

# A chave que autoriza este servico a chamar /api/internal/ do Django (verify-token
# e matches/report). Tem que ser a MESMA INTERNAL_API_KEY do .env do backend.
#
# Ela fica num .env ao lado do binario, fora do git, legivel so pelo ubuntu:
#   /home/ubuntu/rbfserver/.env   (chmod 600)
#   RBF_INTERNAL_API_KEY=<a chave>
#
# Sem ela o lobby SOBE ABERTO: nenhum token e verificado e nenhuma partida e
# reportada. Ele avisa isso no boot, em maiusculas. O "-" deixa o servico subir
# mesmo sem o arquivo, justamente para esse aviso aparecer no journal.
EnvironmentFile=-/home/ubuntu/rbfserver/.env

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
