# Copie para .env e preencha. O .env nunca vai para o repositorio.

DEBUG=1
SECRET_KEY=troque-isto-por-algo-longo-e-aleatorio
ALLOWED_HOSTS=localhost,127.0.0.1,frameperfect.net,www.frameperfect.net
SITE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

DB_NAME=frameperfect
DB_USER=frameperfect
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# A mesma string precisa estar no servidor .NET. E ela que autoriza as rotas
# /api/internal/ - sem ela configurada, elas ficam fechadas.
INTERNAL_API_KEY=

# Em desenvolvimento o backend de console imprime o e-mail no terminal, o que
# evita depender de SMTP so para testar o cadastro.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Frame Perfect <nao-responda@frameperfect.net>
